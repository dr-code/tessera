# Tessera environment variables
# Copy to .env and fill in values as needed.
# Core tessera works with NO env vars — these only enable optional features.

# Optional: debate mode (requires pip install tessera[debate] and codex CLI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the project root tessera uses (default: cwd)
# TESSERA_PROJECT_ROOT=/path/to/your/project

# Feature flags (all default to enabled; set to "false" to disable)
# TESSERA_ENABLE_DEBATE=true
# TESSERA_ENABLE_DASHBOARD=true
# TESSERA_ENABLE_COMPLIANCE=true
